# MineBridge Environment Credentials Template
# Copy this file to .env and fill in your Supabase credentials

# Supabase Auth & Database Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Cloudflare R2 / AWS S3 Storage Credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minebridge-worlds
